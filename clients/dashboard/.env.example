# Only needed when the dashboard and the API are started separately. Under the Aspire
# AppHost (aspire/DotNetBoost.Auditing.AppHost) every value is injected automatically,
# pointing at whichever ports Aspire allocated.

# Base address of the API the dashboard reads: the audit endpoints that MapAuditEndpoints() maps,
# and the sample's product endpoints. Used server-side by the /api/** proxy.
NUXT_AUDIT_API_URL=http://localhost:5280

# Where the sidebar's "API reference" link points.
NUXT_PUBLIC_API_REFERENCE_URL=http://localhost:5280/scalar

# The API's AuditingOptions.MaxPageSize. The page-size selector stops here, because a larger page
# would only be clamped by the engine.
NUXT_PUBLIC_MAX_PAGE_SIZE=200
