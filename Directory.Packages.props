<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning lifts every pinned version below to a direct dependency of the project.
      Right for tests and samples; wrong for the shipped libraries, where it would add packages
      they never use to their NuGet dependencies and force those versions onto applications.
      src/Directory.Build.props turns it off for them, so this is only a default.
    -->
    <CentralPackageTransitivePinningEnabled Condition="'$(CentralPackageTransitivePinningEnabled)' == ''">true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>

  <!-- Aspire: aspire/ and samples/ only, never a shipped package. Same versions as the sibling
       libraries, so the AppHosts share one restored Aspire bundle. -->
  <ItemGroup Label="Aspire — AppHost (orchestration)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.2" />
    <!-- Runs the Nuxt dashboard in clients/dashboard as an orchestrated resource. -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.2" />
    <!-- Referenced only when the matching block in AppHost.cs is uncommented. -->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.MongoDB" Version="13.5.2" />
  </ItemGroup>

  <ItemGroup Label="Aspire — consumed by the sample API">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Aspire — service defaults (telemetry, resilience, discovery)">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup Label="API documentation (sample only)">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.1" />
  </ItemGroup>

  <ItemGroup Label="MongoDB">
    <PackageVersion Include="MongoDB.Driver" Version="3.9.0" />
  </ItemGroup>

  <ItemGroup Label="Dapper">
    <PackageVersion Include="Dapper" Version="2.1.79" />
  </ItemGroup>

  <!--
    Integration testing. These reach real engines in containers, so they are referenced only by
    tests/DotNetBoost.Auditing.IntegrationTests and never by a shipped package.
  -->
  <ItemGroup Label="Integration testing">
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <!--
    Per-TFM versions. The shipped packages multi-target net8.0 (LTS) and net10.0, and the
    Microsoft.Extensions.* family ships a line per runtime. $(TargetFramework) is set during
    NuGet's per-TFM evaluation, so each inner build resolves the family matching its runtime.
  -->
  <PropertyGroup>
    <_Net8 Condition="'$(TargetFramework)' == 'net8.0'">true</_Net8>
  </PropertyGroup>

  <!--
    On net8.0 the shipped libraries (IsShippedLibrary, set in src/Directory.Build.props) take the
    LOWEST version carrying the APIs they use — 8.0.0 — so no application on the 8.0 line can pin
    below them. Requiring 10.x on net8.0 would force it on everyone and fail restore (NU1605) for
    any application pinning 8.x itself. Everything else takes the latest patch.
  -->
  <ItemGroup Label="Microsoft.Extensions — net8.0, shipped libraries" Condition="'$(_Net8)' == 'true' and '$(IsShippedLibrary)' == 'true'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions — net8.0, tests and samples" Condition="'$(_Net8)' == 'true' and '$(IsShippedLibrary)' != 'true'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <!--
    EF Core ships a separate major per runtime — EF Core 10 has no net8.0 asset at all — so the
    store package resolves the family matching its TFM. These are FLOORS for the shipped package,
    not ceilings: an application already on a newer patch keeps it.
  -->
  <ItemGroup Label="ASP.NET Core testing — net8.0" Condition="'$(_Net8)' == 'true'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.30" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core testing — net10.0" Condition="'$(_Net8)' != 'true'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="EF Core — net8.0" Condition="'$(_Net8)' == 'true'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.30" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.30" />
  </ItemGroup>

  <ItemGroup Label="EF Core — net10.0" Condition="'$(_Net8)' != 'true'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The raw ADO.NET drivers for the Dapper store's integration tests, on the versions the EF
         providers beside them resolve, so each is restored once. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Transitive pins: patched versions for packages flagged by NuGet audit. -->
  <ItemGroup Label="Transitive security pins">
    <!-- Microsoft.Data.Sqlite -> SQLitePCLRaw.* 2.1.11 (GHSA-2m69-gcr7-jv3q, fixed after 2.1.11). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.13" />
    <!-- Microsoft.Data.SqlClient 6.1.6 -> System.Security.Cryptography.Pkcs 9.0.11
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Pinned forward for the integration suite,
         which is the only project that references SqlClient; transitive pinning is on for
         everything that is not a shipped library, so this lifts it there and nowhere else. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Aspire.Hosting.AppHost -> MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h). 2.5.307 is the last
         patch of that line, so it stays on the major Aspire was built against. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions — net10.0" Condition="'$(_Net8)' != 'true'">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>
</Project>
