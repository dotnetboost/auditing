<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.Auditing.API</PackageId>
    <Description>
      ASP.NET Core integration for DotNetBoost.Auditing: minimal-API endpoints for reading a
      trail — filtered, paged and always bounded — plus the HttpContext-backed actor accessor that
      records who made each change. The endpoints require authorization by default, because a trail
      says who did what and that is not data to serve anonymously; the erasure and prune endpoints
      are not mapped at all unless asked for.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotNetBoost.Auditing.ApiTests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DotNetBoost.Auditing.Core/DotNetBoost.Auditing.Core.csproj" />
  </ItemGroup>
</Project>
