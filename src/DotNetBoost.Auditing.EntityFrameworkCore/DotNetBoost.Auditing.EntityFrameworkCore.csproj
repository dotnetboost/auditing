<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.Auditing.EntityFrameworkCore</PackageId>
    <Description>
      Entity Framework Core store and change capture for DotNetBoost.Auditing. A
      SaveChangesInterceptor reads the change tracker and appends the audit rows into the same
      SaveChanges — so a change and its trail commit together or neither does — and the two tables
      are mapped into your own DbContext with the indexes the library's own reads need. Supports
      SQL Server, PostgreSQL and SQLite.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotNetBoost.Auditing.ProviderTests" />
    <InternalsVisibleTo Include="DotNetBoost.Auditing.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DotNetBoost.Auditing.Core/DotNetBoost.Auditing.Core.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
