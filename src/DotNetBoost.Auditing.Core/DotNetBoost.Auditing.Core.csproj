<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.Auditing.Core</PackageId>
    <Description>
      Core abstractions and engine for DotNetBoost.Auditing — who changed what, when, and from
      what to what, for any entity in the application, in two tables with no column on your
      entities. Includes IAuditRecorder (the one service application code injects), the store
      contract (IAuditStore), the reader and the pruner, plus the store-neutral recording path:
      entity addressing, actor capture, correlation, per-type ignore and redaction rules, and
      value truncation. Depends on no other DotNetBoost package.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine services are internal: applications use IAuditRecorder. The sibling packages
         build on the engine directly, as the stores do. -->
    <InternalsVisibleTo Include="DotNetBoost.Auditing.EntityFrameworkCore" />
    <InternalsVisibleTo Include="DotNetBoost.Auditing.Dapper" />
    <InternalsVisibleTo Include="DotNetBoost.Auditing.MongoDb" />
    <InternalsVisibleTo Include="DotNetBoost.Auditing.API" />
    <!-- The tests cover the engine directly rather than only through the public surface. -->
    <InternalsVisibleTo Include="DotNetBoost.Auditing.TestSupport" />
    <InternalsVisibleTo Include="DotNetBoost.Auditing.UnitTests" />
    <InternalsVisibleTo Include="DotNetBoost.Auditing.ProviderTests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The only dependency, and the whole of it. No logging, no hosting, no options-pattern
      package: the engine validates its options at Build() rather than through a hosted service,
      and it has nothing to say at runtime that is not either a thrown exception or a recorded
      entry. An application installing an auditing library should not acquire a dependency graph.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
